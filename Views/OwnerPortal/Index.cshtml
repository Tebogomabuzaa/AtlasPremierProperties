@model AtlasPremierProperties.Models.ViewModels.OwnerPortalViewModel
@{
    ViewBag.Title = "My Properties";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Welcome, @Model.Owner.FullName</h1>
        <p class="page-subtitle">Your properties managed by Atlas Premier Properties.</p>
    </div>
</div>

<div class="kpi-grid">
    <div class="kpi">
        <span class="kpi-icon navy">@Html.Partial("_Icon", "properties")</span>
        <div class="kpi-value">@Model.Properties.Count</div>
        <div class="kpi-label">Total properties</div>
    </div>
    <div class="kpi">
        <span class="kpi-icon green">@Html.Partial("_Icon", "home")</span>
        <div class="kpi-value">@Model.OccupiedCount</div>
        <div class="kpi-label">Occupied</div>
    </div>
    <div class="kpi">
        <span class="kpi-icon slate">@Html.Partial("_Icon", "leases")</span>
        <div class="kpi-value">@Model.VacantCount</div>
        <div class="kpi-label">Vacant</div>
    </div>
    <div class="kpi">
        <span class="kpi-icon gold">@Html.Partial("_Icon", "trending")</span>
        <div class="kpi-value">R @Model.TotalMonthlyRent.ToString("N0")</div>
        <div class="kpi-label">Total monthly rent</div>
    </div>
</div>

<div class="table-card">
    <div class="table-scroll">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Description</th>
                    <th>Address</th>
                    <th>Monthly rent</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Properties.Count == 0)
                {
                    <tr><td colspan="4" class="empty">No properties are linked to your account yet.</td></tr>
                }
                @foreach (var property in Model.Properties)
                {
                    <tr>
                        <td>@property.PropertyDescription</td>
                        <td>@property.PhysicalAddress</td>
                        <td>R @property.MonthlyRent.ToString("N0")</td>
                        <td>
                            @if (property.VacancyStatus)
                            {
                                <span class="badge bg-warning text-dark">Vacant</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Occupied</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
