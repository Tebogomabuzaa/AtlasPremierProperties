@model AtlasPremierProperties.Models.Entities.Tenant
@{
    ViewBag.Title = "Delete Tenant";
}

<h2>Delete Tenant</h2>

<div class="alert alert-warning">Are you sure you want to delete this tenant?</div>

<dl class="row">
    <dt class="col-sm-3">Tenant ID</dt>
    <dd class="col-sm-9">@Model.TenantID</dd>
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.FullName</dd>
    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.EmailAddress</dd>
    <dt class="col-sm-3">Verification status</dt>
    <dd class="col-sm-9">@Model.VerificationStatus</dd>
</dl>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Delete</button>
    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary" })
}
