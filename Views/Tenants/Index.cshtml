@model IEnumerable<AtlasPremierProperties.Models.Entities.Tenant>
@{
    ViewBag.Title = "Tenants & KYC";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Tenant Management</h1>
        <p class="page-subtitle">KYC vetting and tenant compliance.</p>
    </div>
</div>

@Html.Partial("_Alerts")
@if (TempData["KycResult"] != null)
{
    var approved = (string)TempData["KycResult"] == "Approved";
    <div class="alert @(approved ? "alert-success" : "alert-danger")">
        <strong>KYC @TempData["KycResult"]:</strong> @TempData["KycMessage"]
    </div>
}

<div class="page-actions">
    <a href="@Url.Action("Create")" class="btn btn-primary">@Html.Partial("_Icon", "plus") Add Tenant</a>
</div>

<div class="table-card">
    <div class="table-scroll">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Tenant ID</th>
                    <th>Name</th>
                    <th>Passport / ID</th>
                    <th>Nationality</th>
                    <th>KYC status</th>
                    <th>Income</th>
                    <th class="actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="empty">No tenant records yet.</td></tr>
                }
                @foreach (var item in Model)
                {
                    var badge = item.VerificationStatus == "Approved" ? "bg-success"
                        : item.VerificationStatus == "Declined" ? "bg-danger"
                        : "bg-secondary";
                    <tr>
                        <td>@item.TenantID</td>
                        <td>@Html.ActionLink(item.FullName, "Details", new { id = item.TenantID })</td>
                        <td>@item.PassportIDNumber</td>
                        <td>@item.Nationality</td>
                        <td><span class="badge @badge">@item.VerificationStatus</span></td>
                        <td>R&nbsp;@item.DeclaredMonthlyIncome.ToString("N2")</td>
                        <td class="actions">
                            @using (Html.BeginForm("RunKyc", "Tenants", new { id = item.TenantID }, FormMethod.Post, new { @class = "d-inline" }))
                            {
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-primary me-2">Run KYC</button>
                            }
                            @Html.ActionLink("Edit", "Edit", new { id = item.TenantID })<span class="sep">|</span>@Html.ActionLink("Delete", "Delete", new { id = item.TenantID })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
