@model IEnumerable<AtlasPremierProperties.Models.Entities.Settlement>
@{
    ViewBag.Title = "Settlements";
}

<h2>Settlements</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["InvoiceLink"] != null)
{
    <div class="alert alert-info">
        <strong>Crypto invoice link:</strong>
        <a href="@TempData["InvoiceLink"]" target="_blank" rel="noopener">@TempData["InvoiceLink"]</a>
    </div>
}

<p>@Html.ActionLink("Create settlement", "Create", null, new { @class = "btn btn-success" })</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Lease</th>
            <th>Gross rent</th>
            <th>Maintenance</th>
            <th>Net</th>
            <th>Mgmt fee (12%)</th>
            <th>Owner payout</th>
            <th>Days</th>
            <th>Date</th>
            <th>Crypto invoice</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.SettlementID</td>
                <td>#@item.LeaseID</td>
                <td>R @item.GrossRent.ToString("N2")</td>
                <td>R @item.MaintenanceCosts.ToString("N2")</td>
                <td>R @item.NetAmount.ToString("N2")</td>
                <td>R @item.ManagementFee.ToString("N2")</td>
                <td><strong>R @item.OwnerPayout.ToString("N2")</strong></td>
                <td>@item.DaysOccupied</td>
                <td>@item.SettlementDate.ToString("dd MMM yyyy")</td>
                <td>
                    @if (!string.IsNullOrEmpty(item.CryptoInvoiceLink))
                    {
                        <a href="@item.CryptoInvoiceLink" target="_blank" rel="noopener" class="btn btn-sm btn-outline-success">Pay</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
