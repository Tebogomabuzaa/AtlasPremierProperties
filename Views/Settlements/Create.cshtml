@{
    ViewBag.Title = "Crypto Settlements";
    var recent = (List<AtlasPremierProperties.Models.Entities.Settlement>)ViewBag.RecentSettlements;
}

<div class="page-header">
    <div>
        <h1 class="page-title">Crypto Settlement Generation</h1>
        <p class="page-subtitle">Work out an owner's payout for a lease and issue a crypto payment link.</p>
    </div>
</div>

<div class="split-grid">
    <section class="panel">
        <h2 class="panel-title">New Invoice</h2>

        @using (Html.BeginForm("Create", "Settlements", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="mb-3">
                <label class="form-label" for="leaseId">Approved lease agreement</label>
                @Html.DropDownList("leaseId", (SelectList)ViewBag.Leases, "Select a lease...", new { @class = "form-select", required = "required" })
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label" for="maintenanceCosts">Maintenance costs (R)</label>
                    <input type="number" id="maintenanceCosts" name="maintenanceCosts" class="form-control" step="0.01" min="0" value="@(Request.Form["maintenanceCosts"] ?? "0")" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="daysOccupied">Days occupied (1 to 31)</label>
                    <input type="number" id="daysOccupied" name="daysOccupied" class="form-control" min="1" max="31" value="@(Request.Form["daysOccupied"] ?? "30")" required />
                </div>
            </div>

            <div class="row g-3 mb-2">
                <div class="col-md-4">
                    <label class="form-label" for="grossRent">Gross rent</label>
                    <input type="text" id="grossRent" class="form-control" placeholder="Auto-populated" readonly tabindex="-1" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="managementFee">Mgmt fee (12%)</label>
                    <input type="text" id="managementFee" class="form-control" readonly tabindex="-1" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="ownerPayout">Owner payout</label>
                    <input type="text" id="ownerPayout" class="form-control" readonly tabindex="-1" />
                </div>
            </div>
            <p class="form-text mb-3">Gross rent is the monthly rent ÷ 30 × days occupied. The 12% fee is taken after maintenance, and the owner receives the rest.</p>

            <div class="mb-4">
                <label class="form-label" for="currency">Settlement currency</label>
                @Html.DropDownList("currency", (SelectList)ViewBag.Currencies, new { @class = "form-select" })
            </div>

            <button type="submit" id="generateInvoice" class="btn btn-primary w-100">@Html.Partial("_Icon", "bitcoin") Generate Crypto Invoice</button>
        }
    </section>

    <section class="panel panel-dark">
        <h2 class="panel-title">Recent Invoices</h2>
        @if (recent.Count == 0)
        {
            <p class="mb-0">No settlements yet.</p>
        }
        else
        {
            <ul class="invoice-list">
                @foreach (var s in recent)
                {
                    <li>
                        <div>
                            <div class="amount">R @s.OwnerPayout.ToString("N2")</div>
                            <div class="muted-on-dark">Lease #@s.LeaseID · @s.SettlementDate.ToString("dd MMM yyyy")</div>
                        </div>
                        @if (!string.IsNullOrEmpty(s.CryptoInvoiceLink))
                        {
                            <a href="@s.CryptoInvoiceLink" target="_blank" rel="noopener">Pay</a>
                        }
                    </li>
                }
            </ul>
            <p class="mt-3 mb-0">@Html.ActionLink("View all settlements", "Index")</p>
        }
    </section>
</div>

@section scripts {
    <script>
        // Preview only: the server recalculates everything when the invoice is generated.
        (function () {
            var rents = @Html.Raw(System.Web.Helpers.Json.Encode((object)ViewBag.LeaseRents));
            var lease = document.getElementById('leaseId');
            var maintenance = document.getElementById('maintenanceCosts');
            var days = document.getElementById('daysOccupied');
            var gross = document.getElementById('grossRent');
            var fee = document.getElementById('managementFee');
            var payout = document.getElementById('ownerPayout');
            var button = document.getElementById('generateInvoice');

            function money(n) {
                return 'R ' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }
            function round(n) {
                return Math.round(n * 100) / 100;
            }
            function update() {
                var rent = rents[lease.value];
                var d = parseInt(days.value, 10);
                var m = parseFloat(maintenance.value) || 0;
                button.disabled = rent === undefined;
                gross.value = fee.value = payout.value = '';
                if (rent === undefined || !(d >= 1 && d <= 31)) return;

                var g = round(rent / 30 * d);
                var net = g - m;
                gross.value = money(g);
                if (net < 0) {
                    payout.value = 'Maintenance exceeds rent';
                    return;
                }
                var f = round(net * 0.12);
                fee.value = money(f);
                payout.value = money(round(net - f));
            }

            [lease, maintenance, days].forEach(function (el) {
                el.addEventListener('input', update);
                el.addEventListener('change', update);
            });
            update();
        })();
    </script>
}
