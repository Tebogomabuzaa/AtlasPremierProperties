@{
    ViewBag.Title = "Create Settlement";
}

<h2>Create Settlement</h2>
<p class="text-muted">
    Gross rent is the lease's monthly rent, pro-rated over 30 days. Net amount is gross rent minus maintenance,
    the management fee is 12% of the net amount, and the owner receives the rest.
</p>

@using (Html.BeginForm("Create", "Settlements", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="mb-3">
        <label class="form-label" for="leaseId">Lease</label>
        @Html.DropDownList("leaseId", (SelectList)ViewBag.Leases, "-- Select lease --", new { @class = "form-select", required = "required" })
    </div>
    <div class="mb-3">
        <label class="form-label" for="maintenanceCosts">Maintenance costs (R)</label>
        <input type="number" id="maintenanceCosts" name="maintenanceCosts" class="form-control" step="0.01" min="0" value="0" required />
    </div>
    <div class="mb-3">
        <label class="form-label" for="daysOccupied">Days occupied (1 to 31)</label>
        <input type="number" id="daysOccupied" name="daysOccupied" class="form-control" min="1" max="31" value="30" required />
        <div class="form-text">30 is a full month. Fewer days pro-rates the rent.</div>
    </div>

    <button type="submit" class="btn btn-success">Calculate and generate crypto invoice</button>
    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary" })
}
