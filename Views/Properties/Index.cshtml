@model IEnumerable<AtlasPremierProperties.Models.Entities.Property>
@{
    ViewBag.Title = "Properties";
}

<h2>Properties</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<p>@Html.ActionLink("Add property", "Create", null, new { @class = "btn btn-primary" })</p>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>ID</th>
            <th>Description</th>
            <th>Address</th>
            <th>Owner</th>
            <th>Monthly rent</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.PropertyID</td>
                <td>@item.PropertyDescription</td>
                <td>@item.PhysicalAddress</td>
                <td>@item.OwnerName</td>
                <td>R @item.MonthlyRent.ToString("N2")</td>
                <td>
                    @if (item.VacancyStatus)
                    {
                        <span class="badge bg-warning text-dark">Vacant</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Occupied</span>
                    }
                </td>
                <td>
                    @Html.ActionLink("Edit", "Edit", new { id = item.PropertyID }) |
                    @Html.ActionLink("Delete", "Delete", new { id = item.PropertyID })
                </td>
            </tr>
        }
    </tbody>
</table>
