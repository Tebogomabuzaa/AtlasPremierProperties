@model IEnumerable<AtlasPremierProperties.Models.Entities.Property>
@{
    ViewBag.Title = "Properties";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Properties</h1>
        <p class="page-subtitle">Portfolio of managed properties.</p>
    </div>
</div>

@Html.Partial("_Alerts")

<div class="page-actions">
    <a href="@Url.Action("Create")" class="btn btn-primary">@Html.Partial("_Icon", "plus") Add Property</a>
</div>

<div class="table-card">
    <div class="table-scroll">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Description</th>
                    <th>Address</th>
                    <th>Owner</th>
                    <th>Rent</th>
                    <th>Status</th>
                    <th class="actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="empty">No property records yet.</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.PropertyDescription</td>
                        <td>@item.PhysicalAddress</td>
                        <td>@item.OwnerName</td>
                        <td>R @item.MonthlyRent.ToString("N2")</td>
                        <td>
                            @if (item.VacancyStatus)
                            {
                                <span class="badge bg-warning text-dark">Vacant</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Occupied</span>
                            }
                        </td>
                        <td class="actions">
                            @Html.ActionLink("Edit", "Edit", new { id = item.PropertyID })<span class="sep">|</span>@Html.ActionLink("Delete", "Delete", new { id = item.PropertyID })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
