@model AtlasPremierProperties.Models.Entities.Property
@{
    ViewBag.Title = "Delete Property";
}

<h2>Delete Property</h2>

<div class="alert alert-warning">Are you sure you want to delete this property?</div>

<dl class="row">
    <dt class="col-sm-3">Property ID</dt>
    <dd class="col-sm-9">@Model.PropertyID</dd>
    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9">@Model.PropertyDescription</dd>
    <dt class="col-sm-3">Address</dt>
    <dd class="col-sm-9">@Model.PhysicalAddress</dd>
    <dt class="col-sm-3">Owner</dt>
    <dd class="col-sm-9">@Model.OwnerName</dd>
</dl>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Delete</button>
    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary" })
}
