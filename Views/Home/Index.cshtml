@{
    ViewBag.Title = "Dashboard";

    var modules = new[]
    {
        new { Title = "Properties", Text = "Property listings, vacancy status and owner links.", Controller = "Properties", Action = "Index" },
        new { Title = "Owners", Text = "Property owners and their owner portal access.", Controller = "Owners", Action = "Index" },
        new { Title = "Tenants and KYC", Text = "Tenant records and simulated KYC verification.", Controller = "Tenants", Action = "Index" },
        new { Title = "Leases", Text = "Lease agreements linking properties, tenants and managers.", Controller = "Leases", Action = "Index" },
        new { Title = "Property managers", Text = "The co-hosts who manage leases.", Controller = "PropertyManagers", Action = "Index" },
        new { Title = "Settlements", Text = "Pro-rata settlements with a unique crypto invoice link.", Controller = "Settlements", Action = "Index" },
        new { Title = "Co-host report", Text = "Occupancy rate by property manager, charted.", Controller = "Reports", Action = "CoHostPerformance" }
    };
}

<div class="text-center my-4">
    <h1 class="display-5">Cryptonics Property Management</h1>
    <p class="lead">Property management with crypto settlement payments for Atlas Premier Properties.</p>
</div>

<div class="row g-4">
    @foreach (var module in modules)
    {
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">@module.Title</h5>
                    <p class="card-text">@module.Text</p>
                    @Html.ActionLink("Open", module.Action, module.Controller, null, new { @class = "btn btn-primary" })
                </div>
            </div>
        </div>
    }
</div>
