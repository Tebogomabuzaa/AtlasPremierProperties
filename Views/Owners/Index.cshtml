@model List<AtlasPremierProperties.Models.Entities.Owners>
@{
    ViewBag.Title = "Owners";
}

<h2>Owners</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<p>@Html.ActionLink("Add owner", "Create", null, new { @class = "btn btn-primary" })</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Owner ID</th>
            <th>Full name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Portal access</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var owner in Model)
        {
            <tr>
                <td>@owner.OwnerID</td>
                <td>@owner.FullName</td>
                <td>@owner.EmailAddress</td>
                <td>@owner.PhoneNumber</td>
                <td>@(owner.HasPortalAccess ? "Yes" : "No")</td>
                <td>
                    @Html.ActionLink("Edit", "Edit", new { id = owner.OwnerID }) |
                    @Html.ActionLink("Delete", "Delete", new { id = owner.OwnerID })
                </td>
            </tr>
        }
    </tbody>
</table>
