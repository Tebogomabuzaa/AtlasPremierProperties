@model List<AtlasPremierProperties.Models.Entities.Owners>
@{
    ViewBag.Title = "Property Owners";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Property Owners</h1>
        <p class="page-subtitle">Owners of the managed properties and their portal access.</p>
    </div>
</div>

@Html.Partial("_Alerts")

<div class="page-actions">
    <a href="@Url.Action("Create")" class="btn btn-primary">@Html.Partial("_Icon", "plus") Add Owner</a>
</div>

<div class="table-card">
    <div class="table-scroll">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Owner ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Portal access</th>
                    <th class="actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="6" class="empty">No owner records yet.</td></tr>
                }
                @foreach (var owner in Model)
                {
                    <tr>
                        <td>@owner.OwnerID</td>
                        <td>@owner.FullName</td>
                        <td>@owner.EmailAddress</td>
                        <td>@owner.PhoneNumber</td>
                        <td>
                            @if (owner.HasPortalAccess)
                            {
                                <span class="badge bg-success">Enabled</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Not set up</span>
                            }
                        </td>
                        <td class="actions">
                            @Html.ActionLink("Edit", "Edit", new { id = owner.OwnerID })<span class="sep">|</span>@Html.ActionLink("Delete", "Delete", new { id = owner.OwnerID })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
