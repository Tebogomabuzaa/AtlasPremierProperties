@model AtlasPremierProperties.Models.Entities.Owner

@{
    ViewBag.Title = "Delete Owner";
}

<h2>Delete Owner</h2>

<p>Are you sure you want to delete this owner?</p>

<dl>
    <dt>Owner ID</dt>
    <dd>@Model.OwnerID</dd>
    <dt>Full Name</dt>
    <dd>@Model.FullName</dd>
    <dt>Email</dt>
    <dd>@Model.EmailAddress</dd>
    <dt>Phone</dt>
    <dd>@Model.PhoneNumber</dd>
</dl>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.OwnerID)

    <button type="submit">Delete</button>
    @Html.ActionLink("Cancel", "Index")
}