@model AtlasPremierProperties.Models.Entities.Owners
@{
    ViewBag.Title = "Delete Owner";
}

<h2>Delete Owner</h2>

<div class="alert alert-warning">Are you sure you want to delete this owner?</div>

<dl class="row">
    <dt class="col-sm-3">Owner ID</dt>
    <dd class="col-sm-9">@Model.OwnerID</dd>
    <dt class="col-sm-3">Full name</dt>
    <dd class="col-sm-9">@Model.FullName</dd>
    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.EmailAddress</dd>
    <dt class="col-sm-3">Phone</dt>
    <dd class="col-sm-9">@Model.PhoneNumber</dd>
</dl>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.OwnerID)

    <button type="submit" class="btn btn-danger">Delete</button>
    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary" })
}
