@model List<AtlasPremierProperties.Services.CoHostStats>
@{
    ViewBag.Title = "Management Reports";
    var start = (DateTime)ViewBag.StartDate;
    var end = (DateTime)ViewBag.EndDate;
    var average = Model.Count == 0 ? 0m : Math.Round(Model.Average(m => m.OccupancyRate), 1);
}

<div class="page-header">
    <div>
        <h1 class="page-title">Co-Host Performance Report</h1>
        <p class="page-subtitle">Comparative occupancy across property managers in the selected period.</p>
    </div>
</div>

@Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

<form method="get" action="@Url.Action("CoHostPerformance")" class="panel filter-card no-print">
    <div>
        <label class="form-label" for="startDate">Start date</label>
        <input type="date" id="startDate" name="startDate" class="form-control" value="@start.ToString("yyyy-MM-dd")" required />
    </div>
    <div>
        <label class="form-label" for="endDate">End date</label>
        <input type="date" id="endDate" name="endDate" class="form-control" value="@end.ToString("yyyy-MM-dd")" required />
    </div>
    <button type="submit" class="btn btn-navy">@Html.Partial("_Icon", "filter") Apply Filters</button>
    <div class="filter-summary">
        Showing @Model.Count property @(Model.Count == 1 ? "manager" : "managers") · Avg @average.ToString("0.0")%
    </div>
</form>

<section class="panel mb-4">
    <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
        <div>
            <h2 class="panel-title mb-1">Occupancy Rate by Property Manager</h2>
            <div class="text-muted small">@start.ToString("dd MMM yyyy") to @end.ToString("dd MMM yyyy")</div>
        </div>
        @if (Model.Count > 0)
        {
            <button type="button" onclick="window.print()" class="btn btn-secondary btn-sm no-print">Export to PDF</button>
        }
    </div>

    @if (Model.Count == 0)
    {
        <div class="chart-empty">No data yet. Add property managers and leases to populate this report.</div>
    }
    else
    {
        <div class="chart-box"><canvas id="coHostChart" aria-label="Occupancy rate by property manager"></canvas></div>
    }

    <div class="legend">
        <span><span class="legend-dot" style="background:#d4a340"></span>Top performer (&ge;90%)</span>
        <span><span class="legend-dot" style="background:#0f1d3d"></span>Standard</span>
    </div>
</section>

@if (Model.Count > 0)
{
    <div class="table-card">
        <div class="table-scroll">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Manager</th>
                        <th>Days occupied</th>
                        <th>Total days</th>
                        <th>Occupancy rate</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.ManagerName</td>
                            <td>@item.DaysOccupied</td>
                            <td>@item.TotalDays</td>
                            <td>
                                @item.OccupancyRate%
                                @if (item.OccupancyRate >= AtlasPremierProperties.Controllers.ReportsController.TopPerformerRate)
                                {
                                    <span class="badge bg-warning text-dark ms-2">Top performer</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section scripts {
    @if (Model.Count > 0)
    {
        <script src="@("https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js")"></script>
        <script>
            // d.labels, d.rates, d.colors come from the controller as JSON
            var d = @Html.Raw(ViewBag.ChartJson);

            new Chart(document.getElementById('coHostChart'), {
                type: 'bar',
                data: {
                    labels: d.labels,
                    datasets: [{
                        label: 'Occupancy rate (%)',
                        data: d.rates,
                        backgroundColor: d.colors,
                        borderRadius: 8,
                        maxBarThickness: 64
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 100,
                            ticks: { callback: function (value) { return value + '%'; } },
                            grid: { color: '#e5e9f0' }
                        },
                        x: { grid: { display: false } }
                    }
                }
            });
        </script>
    }
}
