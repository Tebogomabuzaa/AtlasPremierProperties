@model IEnumerable<AtlasPremierProperties.Models.Entities.LeaseAgreement>
@{
    ViewBag.Title = "Lease Agreements";
}

<div class="page-header">
    <div>
        <h1 class="page-title">Lease Agreements</h1>
        <p class="page-subtitle">Active and archived lease contracts.</p>
    </div>
</div>

@Html.Partial("_Alerts")

<div class="page-actions">
    <a href="@Url.Action("Create")" class="btn btn-primary">@Html.Partial("_Icon", "plus") Add Lease</a>
</div>

<div class="table-card">
    <div class="table-scroll">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Property</th>
                    <th>Tenant</th>
                    <th>Manager</th>
                    <th>Period</th>
                    <th>Rent</th>
                    <th>Status</th>
                    <th class="actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="empty">No lease records yet. Add a property, a tenant who has passed KYC and a property manager first.</td></tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.PropertyAddress</td>
                        <td>@item.TenantName</td>
                        <td>@item.ManagerName</td>
                        <td class="text-nowrap">@item.LeaseStartDate.ToString("dd MMM yyyy") – @item.LeaseEndDate.ToString("dd MMM yyyy")</td>
                        <td>R @item.MonthlyRent.ToString("N2")</td>
                        <td>@Html.Partial("_LeaseStatusBadge", item.LeaseStatus)</td>
                        <td class="actions">
                            @Html.ActionLink("Details", "Details", new { id = item.LeaseID })<span class="sep">|</span>@Html.ActionLink("Edit", "Edit", new { id = item.LeaseID })<span class="sep">|</span>@Html.ActionLink("Delete", "Delete", new { id = item.LeaseID })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
