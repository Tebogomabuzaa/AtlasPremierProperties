@model AtlasPremierProperties.Models.Entities.LeaseAgreement
@{
    ViewBag.Title = "Delete Lease";
    var hasSettlements = (bool)ViewBag.HasSettlements;
}

<h2>Delete Lease #@Model.LeaseID</h2>

@if (hasSettlements)
{
    <div class="alert alert-danger">
        This lease has settlements linked, so it can't be deleted. Edit it and set the status to Ended or Terminated instead.
    </div>
}
else
{
    <div class="alert alert-warning">Are you sure you want to delete this lease?</div>
}

<dl class="row">
    <dt class="col-sm-3">Property</dt>
    <dd class="col-sm-9">@Model.PropertyAddress</dd>
    <dt class="col-sm-3">Tenant</dt>
    <dd class="col-sm-9">@Model.TenantName</dd>
    <dt class="col-sm-3">Property manager</dt>
    <dd class="col-sm-9">@Model.ManagerName</dd>
    <dt class="col-sm-3">Dates</dt>
    <dd class="col-sm-9">@Model.LeaseStartDate.ToString("dd MMM yyyy") to @Model.LeaseEndDate.ToString("dd MMM yyyy")</dd>
    <dt class="col-sm-3">Monthly rent</dt>
    <dd class="col-sm-9">R&nbsp;@Model.MonthlyRent.ToString("N2")</dd>
    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Html.Partial("_LeaseStatusBadge", Model.LeaseStatus)</dd>
</dl>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    if (!hasSettlements)
    {
        <button type="submit" class="btn btn-danger">Delete</button>
    }
    @Html.ActionLink("Cancel", "Index", null, new { @class = "btn btn-secondary" })
}
