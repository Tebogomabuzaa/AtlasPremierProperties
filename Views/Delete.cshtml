```csharp
@model AtlasPremierProperties.Models.Entities.LeaseAgreement

@{
    ViewBag.Title = "Delete Lease";
}

<h2>Delete Lease</h2>

<h3>Are you sure you want to delete this lease?</h3>

<div>
    <hr />

    <dl class="dl-horizontal">

        <dt>
            Property
        </dt>
        <dd>
            @Html.DisplayFor(model => model.PropertyAddress)
        </dd>

        <dt>
            Tenant
        </dt>
        <dd>
            @Html.DisplayFor(model => model.TenantName)
        </dd>

        <dt>
            Manager
        </dt>
        <dd>
            @Html.DisplayFor(model => model.ManagerName)
        </dd>

        <dt>
            Start Date
        </dt>
        <dd>
            @Html.DisplayFor(model => model.LeaseStartDate)
        </dd>

        <dt>
            End Date
        </dt>
        <dd>
            @Html.DisplayFor(model => model.LeaseEndDate)
        </dd>

        <dt>
            Monthly Rent
        </dt>
        <dd>
            @Html.DisplayFor(model => model.MonthlyRent)
        </dd>

        <dt>
            Status
        </dt>
        <dd>
            @Html.DisplayFor(model => model.LeaseStatus)
        </dd>

    </dl>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(model => model.LeaseID)

        <div class="form-actions no-color">
            <input type="submit" value="Delete Lease" class="btn btn-danger" />
            @Html.ActionLink("Back to Leases", "Index", null, new { @class = "btn btn-default" })
        </div>
    }
</div>
```
